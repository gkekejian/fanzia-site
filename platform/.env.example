# Fanzia Wholesale Platform — local/dev environment variables.
# Never commit a filled-in .env or .env.local. This file only documents
# what Phase 0/1 code actually reads.

# Postgres connection string. Local dev default matches docker-compose.yml.
DATABASE_URL=postgres://fanzia:fanzia_dev_only@localhost:55432/fanzia_platform

# Base URL the app is served from (used to build magic-link and resume-token
# links in emails). No trailing slash.
APP_BASE_URL=http://localhost:3100

# 32-byte (64 hex char) key used to encrypt TOTP secrets at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Resend API key for transactional email (applicant/admin notifications,
# magic links). If unset, emails are logged to stdout instead — same
# fallback pattern as the marketing site.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@fanzia.io

# Seed data for the three named admin identities (build prompt §14.1).
# Never commit real values. Seed script refuses to run outside local/dev.
SEED_OWNER_GEORGE_EMAIL=george@fanzia.io
SEED_OWNER_JOSEPH_EMAIL=CHANGE-BEFORE-USE@fanzia.io
SEED_AI_OPERATOR_NAME=Muse

# Staging/production owner provisioning (lib/bootstrap.ts, runs once per server
# process via the root layout). Comma-separated emails of the real owners.
# Missing rows are created as active owners; existing rows are never touched.
# Nothing else is ever provisioned — no fixtures, no test data.
BOOTSTRAP_OWNER_EMAILS=

# File storage. When unset, uploads are written to platform/.data/uploads
# (gitignored, local-disk stand-in) instead of Cloudflare R2 — same
# fallback pattern used for email above. Fill in all four to use real R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Cloudflare Turnstile bot protection (free tier) on public write endpoints:
# wholesale application submit, order-request placement, contact ingest.
# Get both values from Cloudflare Dashboard → Turnstile → your widget.
# The site key is public (NEXT_PUBLIC_ prefix ships it to the browser);
# the secret key stays server-side — never commit a real value.
# When TURNSTILE_SECRET_KEY is unset, server verification is skipped with
# a warning and submissions are ALLOWED (fail-open) so local dev and
# pre-key deploys never break. Set both keys to arm protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel Cron shared secret. Vercel sends it as
# Authorization: Bearer $CRON_SECRET automatically when set on the project.
# Without a matching secret the /api/cron/* routes answer 401 and do nothing.
CRON_SECRET=

# Dashboard AI operator chat (admin panel). The chat route reads this at
# request time; when unset the panel shows a "not configured" notice.
# Model id is configurable; default is claude-sonnet-5. Expect ~$5-15/mo
# at two-owner dashboard volume — the one non-free line item in the stack.
ANTHROPIC_API_KEY=
FANZIA_AGENT_MODEL=claude-sonnet-5
